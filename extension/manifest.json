{
  "manifest_version": 3,
  "name": "Deep Grab",
  "version": "1.0.0",
  "description": "Find videos on the current page and send them to the Deep Video Downloader desktop app (WebSocket 127.0.0.1:8765).",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Deep Grab"
  }
}