{
  "name": "deep-video-downloader",
  "version": "1.3.2",
  "description": "Desktop app: WebSocket server + MP4 download manager with advanced control and auto proxy boost.",
  "author": "DeepGrab",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "check": "node check.js",
    "test": "node test-config.js && node test-hls.js && node test-proxy.js && node test-e2e-harness.js"
  },
  "dependencies": {
    "follow-redirects": "^1.15.6",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "socks-proxy-agent": "^8.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.deepgrab.downloader",
    "productName": "DeepVideoDownloader",
    "files": [
      "main.js",
      "preload.js",
      "browser-preload.js",
      "renderer.js",
      "browser.html",
      "renderer.html",
      "styles.css",
      "config.js",
      "downloader.js",
      "proxy.js",
      "lib",
      "extension"
    ],
    "asar": true,
    "asarUnpack": [
      "extension/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
